                <TextBlock x:Name="NetworkAdaptersText" Text="Consulta local: não envia dados nem altera a ligação." TextWrapping="Wrap" />
                <TextBlock Text="A velocidade anunciada pelo adaptador não é a velocidade da Internet. Pode haver várias ligações e VPNs ativas; não assumimos qual transporta cada aplicação." TextWrapping="Wrap" Foreground="#95A1BF" />
              </StackPanel>
            </Border>
            <Border Background="#171D2F" CornerRadius="14" Padding="22" BorderBrush="#2A3350" BorderThickness="1">
              <StackPanel Spacing="14">
                <TextBlock Text="Compara a resposta dos DNS" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Envia três consultas de example.com a cada fornecedor por UDP/IPv4. Vais contactar serviços externos; pode demorar alguns segundos. Mede a resolução de nomes nesta ligação, não o ping dos jogos. Não altera o DNS do PC." TextWrapping="Wrap" Foreground="#C3CBE0" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Button x:Name="DnsButton" Content="Medir DNS" Click="MeasureDns" Style="{StaticResource AccentButtonStyle}" />
                  <Button x:Name="CancelDnsButton" Content="Cancelar" Click="CancelDns" IsEnabled="False" />
                </StackPanel>
                <TextBlock x:Name="DnsResultsText" Text="Ainda não há medições." TextWrapping="Wrap" />
                <Button Content="Configurar DNS nas definições do Windows" Tag="ms-settings:network-status" Click="OpenSetting" />
                <TextBlock Text="As definições externas não entram no restauro do NEXUS. Uma medição curta pode variar com o tráfego ou ser bloqueada pela rede." TextWrapping="Wrap" Foreground="#95A1BF" />
