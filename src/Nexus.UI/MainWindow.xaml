                <Button Content="Ativar / pausar automático" Click="ToggleGameAutomation" />
                <TextBlock Text="Desligado. Escolhe o perfil, os ajustes e a biblioteca antes de ativar." FontSize="14" TextWrapping="Wrap" x:Name="AutomationStatus" />
              </StackPanel>
            </Border>
            <Border Background="#171D2F" CornerRadius="14" Padding="22" BorderBrush="#2A3350" BorderThickness="1">
              <StackPanel Spacing="14">
                <TextBlock Text="Adições manuais e sessões avançadas" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Os jogos encontrados automaticamente aparecem em Os meus jogos. Esta seleção manual é um recurso avançado para instalações não identificadas. A deteção compara o caminho completo; processos protegidos podem não estar acessíveis. Nenhum jogo é iniciado pela NEXUS." TextWrapping="Wrap" />
                <ListView x:Name="LibraryApps" MaxHeight="180" SelectionMode="Single" AutomationProperties.Name="Biblioteca de aplicações">
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Display}" TextWrapping="Wrap" />
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="Adicionar executável" Click="AddLibraryApp" />
                  <Button Content="Retirar da biblioteca" Click="RemoveLibraryApp" />
                </StackPanel>
                <CheckBox x:Name="DiscoveryChoice" Content="Avisar sobre aplicações da biblioteca" />
                <Button Content="Detetar aplicações abertas" Click="DetectLibraryApps" />
                <TextBlock x:Name="LibraryDetectionText" Text="A deteção apenas avisa. Revê o perfil antes de iniciar uma sessão." TextWrapping="Wrap" />
                <ComboBox x:Name="LibraryDetected" DisplayMemberPath="Display" HorizontalAlignment="Stretch" AutomationProperties.Name="Aplicação detetada" />
                <Button Content="Rever e iniciar perfil" Click="StartLibrarySession" />
                <TextBlock Text="Balanceado, Competitivo, Streaming e Personalizado usam limites seguros próprios. A NEXUS não conhece os ajustes internos do TL. O perfil pode usar o plano disponível escolhido abaixo. Usa Terminar e repor ao acabar." TextWrapping="Wrap" Foreground="#95A1BF" />
              </StackPanel>
            </Border>
            <Expander Header="Prioridade manual e definições do Windows" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
