                <Border Background="#171D2F" CornerRadius="14" Padding="22" BorderBrush="#2A3350" BorderThickness="1">
                  <StackPanel Spacing="14">
                    <TextBlock Text="Rever ficheiros antigos por categoria" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Procura ficheiros na categoria escolhida sem escrita ou acesso nos últimos 7 dias. Escolhe os ficheiros antes de os enviar à Lixeira. Não remove pastas nem segue ligações para outros locais." TextWrapping="Wrap" Foreground="#C3CBE0" />
