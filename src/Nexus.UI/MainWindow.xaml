<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Nexus.UI.MainWindow" Title="NEXUS Optimizer">
  <Grid x:Name="Root" RequestedTheme="Dark" Background="#090D0E">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="194" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Background="#0D1213" Padding="14">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="2" Margin="8,8,0,24">
          <TextBlock Text="NEXOS" FontFamily="Segoe UI Black" FontStyle="Italic" FontSize="29" FontWeight="Black" Foreground="#F4F7F5" />
          <TextBlock Text="O P T I M I Z E R" FontSize="9" Foreground="#C1CBCD" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="6" x:Name="NavigationButtons">
            <StackPanel x:Name="FavoriteNavigation" Spacing="4" Visibility="Collapsed" />
            <Button Tag="overview" Click="Navigate" Style="{StaticResource NexusNavigationButton}"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE80F;" FontSize="17"/><TextBlock Text="Dashboard" FontSize="13"/></StackPanel></Button>
            <Button Tag="library" Click="Navigate" Style="{StaticResource NexusNavigationButton}"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE7FC;" FontSize="17"/><TextBlock Text="Jogos" FontSize="13"/></StackPanel></Button>
            <Button Tag="preferences" Click="Navigate" Style="{StaticResource NexusNavigationButton}"><StackPanel Orientation="Horizontal" Spacing="12"><Path Width="17" Height="17" Stretch="Uniform" Fill="{ThemeResource TextFillColorPrimaryBrush}" Data="M0,0 H7 V7 H0 Z M9,0 H16 V7 H9 Z M0,9 H7 V16 H0 Z M9,9 H16 V16 H9 Z"/><TextBlock Text="Windows" FontSize="13"/></StackPanel></Button>
            <Button Tag="hardware" Click="Navigate" Style="{StaticResource NexusNavigationButton}"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE7F4;" FontSize="17"/><TextBlock Text="GPU e hardware" FontSize="13"/></StackPanel></Button>
            <Button Tag="memory" Click="Navigate" Style="{StaticResource NexusNavigationButton}"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE950;" FontSize="17"/><TextBlock Text="CPU / RAM" FontSize="13"/></StackPanel></Button>
            <Button Tag="vpn" Click="Navigate" Style="{StaticResource NexusNavigationButton}"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE774;" FontSize="17"/><TextBlock Text="Rede &amp; VPN" FontSize="13"/></StackPanel></Button>
            <Button Tag="mouselab" Click="Navigate" Style="{StaticResource NexusNavigationButton}"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE962;" FontSize="17"/><TextBlock Text="Mouse / Input" FontSize="13"/></StackPanel></Button>
            <Button Tag="fivem" Click="Navigate" Style="{StaticResource NexusNavigationButton}"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE7FC;" FontSize="17"/><TextBlock Text="FiveM &amp; Mods" FontSize="13"/></StackPanel></Button>
            <Button Tag="autoclean" Click="Navigate" Style="{StaticResource NexusNavigationButton}"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE74D;" FontSize="17"/><TextBlock Text="Limpeza" FontSize="13"/></StackPanel></Button>
            <Button Tag="history" Click="Navigate" Style="{StaticResource NexusNavigationButton}"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE81C;" FontSize="17"/><TextBlock Text="Restore" FontSize="13"/></StackPanel></Button>
            <Button Tag="protection" Click="Navigate" Style="{StaticResource NexusNavigationButton}"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE83D;" FontSize="17"/><TextBlock Text="Proteção do PC" FontSize="13"/></StackPanel></Button>
            <Expander Header="Mais ferramentas" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,18,0,0">
              <StackPanel x:Name="AdvancedNavigationButtons" Spacing="4">
                <Button Tag="optimize" Click="Navigate" Style="{StaticResource NexusNavigationButton}" Content="Otimização inteligente" />
                <Button Tag="gaming" Click="Navigate" Style="{StaticResource NexusNavigationButton}" Content="Game Boost" />
                <Button Tag="precision" Click="Navigate" Style="{StaticResource NexusNavigationButton}" Content="Rato e precisão" />

                <Button Tag="hardware" Click="Navigate" Style="{StaticResource NexusNavigationButton}" Content="Hardware e GPU" />
                <Button Tag="tweaks" Click="Navigate" Style="{StaticResource NexusNavigationButton}">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="" FontSize="17" />
                    <TextBlock Text="Ajustes visuais" FontSize="14" />
                  </StackPanel>
                </Button>
                <Button Tag="memory" Click="Navigate" Style="{StaticResource NexusNavigationButton}">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="" FontSize="17" />
                    <TextBlock Text="CPU e memória" FontSize="14" />
                  </StackPanel>
                </Button>
                <Button Tag="network" Click="Navigate" Style="{StaticResource NexusNavigationButton}">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="" FontSize="17" />
                    <TextBlock Text="Rede e DNS" FontSize="14" />
                  </StackPanel>
                </Button>
                <Button Tag="latency" Click="Navigate" Style="{StaticResource NexusNavigationButton}">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="" FontSize="17" />
                    <TextBlock Text="Testar ligação" FontSize="14" />
                  </StackPanel>
                </Button>
                <Button Tag="autoclean" Click="Navigate" Style="{StaticResource NexusNavigationButton}">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="" FontSize="17" />
                    <TextBlock Text="Limpeza" FontSize="14" />
                  </StackPanel>
                </Button>
                <Button Tag="benchmark" Click="Navigate" Style="{StaticResource NexusNavigationButton}">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="" FontSize="17" />
                    <TextBlock Text="Testes e FPS" FontSize="14" />
                  </StackPanel>
                </Button>
                <Button Tag="tuner" Click="Navigate" Style="{StaticResource NexusNavigationButton}">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="" FontSize="17" />
                    <TextBlock Text="Aplicações" FontSize="14" />
                  </StackPanel>
                </Button>
                <Button Tag="preferences" Click="Navigate" Style="{StaticResource NexusNavigationButton}">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="" FontSize="17" />
                    <TextBlock Text="Windows" FontSize="14" />
                  </StackPanel>
                </Button>
                <Button Tag="tools" Click="Navigate" Style="{StaticResource NexusNavigationButton}">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="" FontSize="17" />
                    <TextBlock Text="Ferramentas" FontSize="14" />
                  </StackPanel>
                </Button>
                <Button Tag="catalog" Click="Navigate" Style="{StaticResource NexusNavigationButton}">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="" FontSize="17" />
                    <TextBlock Text="Todas as funções" FontSize="14" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Expander>
            <Border Height="1" Background="#283234" Margin="6,18,6,10" />
            <Button Tag="settings" Click="Navigate" Style="{StaticResource NexusNavigationButton}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="" FontSize="17" />
                <TextBlock Text="Preferências e IA" FontSize="14" />
              </StackPanel>
            </Button>
            <Button Tag="help" Click="Navigate" Style="{StaticResource NexusNavigationButton}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="" FontSize="17" />
                <TextBlock Text="Ajuda" FontSize="14" />
              </StackPanel>
            </Button>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Spacing="6" Margin="10,12,0,0">
          <TextBlock Text="NEXUS · SEM SUBSCRIÇÃO" FontSize="10" TextWrapping="Wrap" Foreground="#43DF79" />
          <TextBlock Text="1.0.1 · experimental" FontSize="11" TextWrapping="Wrap" Foreground="#9DA9AE" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Padding="16,14,16,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid RowSpacing="8" ColumnSpacing="14" Margin="0,0,0,14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Spacing="3">
          <TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="23" FontWeight="SemiBold" />
          <TextBlock Text="O teu PC. Sob controlo." Foreground="#9DA9AE" FontSize="12" />
        </StackPanel>
        <AutoSuggestBox Grid.Column="1" x:Name="QuickSearch" Width="230" VerticalAlignment="Center" PlaceholderText="Procurar uma função…" TextMemberPath="Title" TextChanged="SearchChanged" QuerySubmitted="SearchSubmitted" AutomationProperties.Name="Pesquisar páginas e funções" />
        <StackPanel x:Name="HeaderQuickActions" Grid.Row="1" Orientation="Horizontal" Spacing="8">
          <Button Content="Desfazer alterações" Click="RestoreEverything" Padding="10,5" FontSize="12"/>
          <TextBlock x:Name="GlobalChangeStatus" Text="Nenhuma alteração por repor" FontSize="11" Foreground="#9DA9AE" VerticalAlignment="Center" MaxWidth="440" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button Grid.Row="1" Grid.Column="1" x:Name="FavoritePageButton" Content="Guardar favorito" Click="ToggleFavoritePage" HorizontalAlignment="Right" Padding="10,5" FontSize="12" />
      </Grid>
      <ScrollViewer x:Name="PageScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="18">
          <ContentControl x:Name="MouseLabHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" />
          <StackPanel x:Name="OverviewPanel" Spacing="12">
            <ContentControl x:Name="DashboardHost" HorizontalContentAlignment="Stretch" />
            <StackPanel x:Name="DashboardLegacy" Visibility="Collapsed">
              <Button x:Name="HomeOptimizeButton" Content="Otimização rápida" Click="SmartOptimize" Style="{StaticResource AccentButtonStyle}" />
              <Button x:Name="HomeAnalyzeButton" Content="Analisar sistema" Click="SmartAnalyze" />
              <Canvas x:Name="CpuGraph" Height="60"><Polyline x:Name="CpuLine" Stroke="#43DF79" StrokeThickness="2" /></Canvas>
              <Canvas x:Name="MemoryGraph" Height="60"><Polyline x:Name="MemoryLine" Stroke="#43DF79" StrokeThickness="2" /></Canvas>
            </StackPanel>
            <Expander Header="Análise inteligente e detalhes" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="10">
                <ProgressBar x:Name="AssistantProgress" IsIndeterminate="True" Visibility="Collapsed" />
                <TextBlock x:Name="AssistantSummary" Text="Pronto para analisar. Nenhuma definição foi alterada por este painel." TextWrapping="Wrap" />
                <TextBlock x:Name="AssistantEvidence" Text="Análise local · revisão antes de aplicar · histórico e restauro" FontSize="12" TextWrapping="Wrap" />
                <TextBlock x:Name="UptimeText" TextWrapping="Wrap" Foreground="#9DA9AE" FontSize="12" />
              </StackPanel>
            </Expander>
            <Expander Header="Recomendações e ajustes que mudaram" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="12">
                <Border Background="#121819" CornerRadius="14" Padding="22" BorderBrush="#283234" BorderThickness="1">
                  <StackPanel Spacing="14">
                    <TextBlock Text="Conferir ajustes que mudaram" FontSize="20" FontWeight="SemiBold" />
                    <Button Content="Verificar últimos ajustes aplicados" Click="CheckDrift" />
                    <TextBlock x:Name="DriftSummary" Text="Compara os últimos valores guardados, sem os reaplicar." TextWrapping="Wrap" />
                    <ListView x:Name="DriftList" MaxHeight="240" SelectionMode="Single">
                      <ListView.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Display}" TextWrapping="Wrap" Margin="0,6" />
                        </DataTemplate>
                      </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="Rever reaplicação do selecionado" Click="ReapplyDrift" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Expander>
            <Expander Header="Estado da análise local" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="12">
                <TextBlock x:Name="AnalysisText" Text="A análise é local e não altera definições." TextWrapping="Wrap" Foreground="#C1CBCD" />
              </StackPanel>
            </Expander>
          </StackPanel>
          <StackPanel x:Name="OptimizePanel" Visibility="Collapsed" Spacing="16">
            <Border Background="#121819" BorderBrush="#283234" BorderThickness="1" CornerRadius="14" Padding="20">
              <StackPanel Spacing="12">
                <TextBlock Text="Otimização inteligente" FontSize="23" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBlock Text="1. Analisar o PC   2. Aplicar apenas o que faz sentido   3. Comparar e desfazer" FontSize="14" TextWrapping="Wrap" />
                <Button x:Name="QuickOptimizeButton" Content="Analisar e otimizar automaticamente" Click="SmartOptimize" Style="{StaticResource AccentButtonStyle}" />
                <TextBlock Text="O automático só pode reduzir cinco efeitos visuais com pressão sustentada de CPU ou RAM. Energia, rato, processos, ficheiros e segurança ficam fora deste modo." TextWrapping="Wrap" FontSize="12" Foreground="#9DA9AE" />
                <ComboBox x:Name="OptimizationPresetList" HorizontalAlignment="Stretch" AutomationProperties.Name="Perfil de seleção" Header="Objetivo" SelectionChanged="BoostPresetChanged" />
                <Button x:Name="AnalyzeBoostButton" Content="Analisar para escolher manualmente" Click="AnalyzeBoost" />
                <TextBlock Text="Clica em Analisar para preparar a seleção." FontSize="14" TextWrapping="Wrap" x:Name="BoostStatus" />
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button x:Name="CancelBoostButton" Content="Cancelar análise" Click="CancelBoost" IsEnabled="False" />
              <Button Content="Exportar diagnóstico" Click="ExportBoostReport" />
            </StackPanel>
            <StackPanel Spacing="10" x:Name="BoostChoices" />
            <Expander Header="Diagnóstico e recomendações" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="16">
                <TextBlock x:Name="BoostHardwareText" Text="Analisa o PC para consultar hardware e amostras." TextWrapping="Wrap" />
                <StackPanel x:Name="BoostAdvice" Spacing="18" />
              </StackPanel>
            </Expander>
            <Button Content="Aplicar seleção" Click="ApplyBoost" Style="{StaticResource AccentButtonStyle}" x:Name="ApplyBoostButton" IsEnabled="False" />
            <Expander Header="Escolher ajustes manualmente" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="12">
                <Border Background="#121819" CornerRadius="14" Padding="22" BorderBrush="#283234" BorderThickness="1">
                  <StackPanel Spacing="14">
                    <TextBlock Text="Preparar uma seleção" FontSize="20" FontWeight="SemiBold" />
                    <Button Content="Preparar seleção do perfil" Click="ChoosePreset" />
                    <TextBlock x:Name="PresetDescription" Text="Escolhe Balanceado, Competitivo ou Streaming. A seleção não aplica alterações automaticamente; revê os ajustes abaixo." TextWrapping="Wrap" Foreground="#C1CBCD" />
                  </StackPanel>
                </Border>
                <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Escolhe antes de aplicar" Message="Estes ajustes não garantem mais FPS. Energia de alto desempenho pode aumentar consumo, temperatura e ruído." />
                <Border Background="#121819" CornerRadius="14" Padding="22" BorderBrush="#283234" BorderThickness="1">
                  <StackPanel Spacing="14">
                    <CheckBox x:Name="PowerChoice" Content="Alterar plano de energia" />
                    <TextBlock x:Name="CurrentPower" Text="A consultar planos disponíveis…" TextWrapping="Wrap" Foreground="#C1CBCD" />
                    <ComboBox x:Name="PowerPlans" HorizontalAlignment="Stretch" AutomationProperties.Name="Plano de energia" />
                    <TextBlock Text="Só são usados planos já disponíveis no teu PC. O plano anterior fica guardado para restauro." TextWrapping="Wrap" Foreground="#9DA9AE" />
                  </StackPanel>
                </Border>
                <Border Background="#121819" CornerRadius="14" Padding="22" BorderBrush="#283234" BorderThickness="1">
                  <StackPanel Spacing="14">
                    <CheckBox x:Name="AnimationChoice" Content="Reduzir animações do Windows" />
                    <TextBlock Text="Desativa animações das áreas de conteúdo em aplicações que respeitam esta opção. Pode tornar a navegação mais direta; não aumenta a capacidade da gráfica." TextWrapping="Wrap" Foreground="#C1CBCD" />
                  </StackPanel>
                </Border>
                <Border Background="#121819" CornerRadius="14" Padding="22" BorderBrush="#283234" BorderThickness="1">
                  <StackPanel Spacing="14">
                    <TextBlock Text="Interface e teclado" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Preferências opcionais. Cada valor anterior fica guardado para restauro. Estas opções mudam a utilização do Windows; não são medições de desempenho." TextWrapping="Wrap" Foreground="#C1CBCD" />
                    <StackPanel x:Name="PreferenceChoices" Spacing="14" />
                  </StackPanel>
                </Border>
                <Button x:Name="ApplySystemButton" Content="Rever e aplicar selecionados" Click="ApplySystem" Style="{StaticResource AccentButtonStyle}" />
              </StackPanel>
            </Expander>
          </StackPanel>
          <StackPanel x:Name="InstalledGamesPanel" Visibility="Collapsed" Spacing="18">
            <Border Style="{StaticResource NexusCard}">
              <StackPanel Spacing="12">
                <TextBlock Text="Os teus jogos, num só lugar" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="A NEXUS lê as bibliotecas acessíveis deste PC. Guarda um perfil por jogo e revê os ajustes antes de iniciar. Os ficheiros dos jogos e o anti-cheat ficam intactos." TextWrapping="Wrap" Foreground="#C1CBCD" />
                <Button x:Name="InstalledScanButton" Content="Procurar jogos instalados" Click="ScanInstalledGames" />
                <TextBlock x:Name="InstalledGamesStatus" Text="A biblioteca será procurada automaticamente ao abrir a NEXUS." TextWrapping="Wrap" />
                <Button Content="Ativar / pausar Game Boost dos meus jogos" Click="TogglePerGameAutomation" Style="{StaticResource AccentButtonStyle}" />
                <TextBlock Text="As escolhas por jogo ficam guardadas. A autorização de execução automática é confirmada nesta abertura; novos jogos não são incluídos sem escolha." TextWrapping="Wrap" Foreground="#9DA9AE" />
              </StackPanel>
            </Border>
            <StackPanel x:Name="InstalledGameCards" Spacing="14" />
            <Expander Header="Os teus perfis e importação" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="12">
                <TextBlock Text="Padrão acompanha a sessão. Competitivo reduz duas animações. Máximo permite cinco preferências visuais. Nenhum perfil fecha programas, altera o jogo ou garante mais FPS." TextWrapping="Wrap" />
                <TextBox x:Name="CustomProfileName" Header="Nome do perfil personalizado" MaxLength="60" />
                <ComboBox x:Name="CustomProfileTemplate" Header="Preferências a guardar" HorizontalAlignment="Stretch" />
                <Button Content="Guardar o meu perfil" Click="SaveCustomGameProfile" />
                <Button Content="Exportar perfil personalizado ou modelo escolhido" Click="ExportGameProfile" />
                <Button Content="Importar perfil" Click="ImportGameProfile" />
                <TextBlock Text="Importar só guarda preferências visuais compatíveis. Não executa comandos, não aplica ajustes e não ativa o automático." TextWrapping="Wrap" Foreground="#9DA9AE" />
              </StackPanel>
            </Expander>
            <Button Content="Deteção manual e sessões avançadas" Tag="gaming" Click="Navigate" />
          </StackPanel>
          <StackPanel x:Name="ProtectionPanel" Visibility="Collapsed" Spacing="18">
            <Border Style="{StaticResource NexusCard}">
              <StackPanel Spacing="14">
                <TextBlock Text="Proteção com Microsoft Defender" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="A proteção antivírus é fornecida pelo Windows. A NEXUS reúne o estado e os pedidos de análise num só lugar." TextWrapping="Wrap" Foreground="#C1CBCD" />
                <InfoBar x:Name="ProtectionState" IsOpen="True" IsClosable="False" Severity="Informational" Title="Estado comunicado pelo Windows" Message="A consultar a proteção deste PC…" />
                <TextBlock x:Name="ProtectionDetails" Text="Os dados serão apresentados depois da consulta local." TextWrapping="Wrap" />
                <TextBlock x:Name="ProtectionCheckedAt" Text="Ainda sem consulta concluída." TextWrapping="Wrap" Foreground="#9DA9AE" />
                <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2">
                  <Button Content="Abrir Segurança do Windows" Click="OpenWindowsProtection" Style="{StaticResource AccentButtonStyle}" Margin="0,0,10,8" />
                  <Button x:Name="ProtectionRefreshButton" Content="Atualizar estado" Click="RefreshProtection" Margin="0,0,0,8" />
                </VariableSizedWrapGrid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource NexusCard}">
              <StackPanel Spacing="12">
                <TextBlock Text="Analisar e atualizar" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="ProtectionPermissions" Text="A disponibilidade depende do fornecedor ativo, dos direitos e das políticas deste PC." TextWrapping="Wrap" Foreground="#C1CBCD" />
                <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" ItemWidth="190" ItemHeight="44">
                  <Button x:Name="ProtectionQuickButton" Content="Análise rápida" Tag="QuickScan" Click="RequestProtectionAction" IsEnabled="False" Margin="0,0,10,8" />
                  <Button x:Name="ProtectionFullButton" Content="Análise completa" Tag="FullScan" Click="RequestProtectionAction" IsEnabled="False" Margin="0,0,10,8" />
                  <Button x:Name="ProtectionUpdateButton" Content="Atualizar definições" Tag="UpdateSignatures" Click="RequestProtectionAction" IsEnabled="False" Margin="0,0,0,8" />
                </VariableSizedWrapGrid>
                <ProgressBar x:Name="ProtectionProgress" IsIndeterminate="True" Visibility="Collapsed" />
                <TextBlock x:Name="ProtectionRequestStatus" Text="Nenhum pedido enviado nesta abertura. O Defender mantém o seu funcionamento normal." TextWrapping="Wrap" />
                <TextBlock Text="As análises podem isolar ameaças automaticamente no Defender. Não fazem parte do Undo do otimizador. Não são iniciadas pela análise inteligente, pelo Game Boost ou por esta consulta de estado." TextWrapping="Wrap" Foreground="#9DA9AE" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource NexusCard}">
              <StackPanel Spacing="12">
                <TextBlock Text="Histórico e quarentena" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="ProtectionScanHistory" Text="A consultar as datas comunicadas pelo Defender…" TextWrapping="Wrap" />
                <Button Content="Consultar deteções e quarentena no Windows" Click="OpenWindowsProtection" />
                <TextBlock Text="Na Segurança do Windows, abre Proteção contra vírus e ameaças → Histórico de proteção. A NEXUS não lê ficheiros suspeitos, envia amostras para a OpenAI ou decide restaurar ameaças." TextWrapping="Wrap" Foreground="#9DA9AE" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="VpnPanel" Visibility="Collapsed" Spacing="18" RequestedTheme="Dark">
            <StackPanel.Resources>
              <Style x:Key="VpnCard" TargetType="Border">
                <Setter Property="Background" Value="#101010" /><Setter Property="BorderBrush" Value="#363636" />
                <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="16" /><Setter Property="Padding" Value="22" />
              </Style>
              <Style x:Key="VpnAction" TargetType="Button">
                <Setter Property="Background" Value="#242424" /><Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="#555555" /><Setter Property="Padding" Value="14,10" />
              </Style>
            </StackPanel.Resources>
            <Border Style="{StaticResource VpnCard}">
              <StackPanel Spacing="14">
                <TextBlock Text="NEXOS VPN" FontSize="12" CharacterSpacing="180" Foreground="#BBBBBB" />
                <TextBlock x:Name="VpnStateText" Text="A consultar o WARP…" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="White" />
                <TextBlock Text="Cloudflare WARP · opção gratuita" FontSize="17" Foreground="White" />
                <TextBlock x:Name="VpnAvailabilityText" Text="A deteção consulta apenas este PC. Ainda não foi pedido qualquer teste externo ou ligação." TextWrapping="Wrap" Foreground="#CCCCCC" />
                <TextBlock x:Name="VpnVerificationText" Text="Passagem de tráfego: ainda não verificada." TextWrapping="Wrap" Foreground="White" />
                <ItemsControl>
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><VariableSizedWrapGrid ItemWidth="190" ItemHeight="52" Orientation="Horizontal" MaximumRowsOrColumns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <Button x:Name="VpnConnectButton" Content="Ligar WARP" Tag="connect" Click="RequestVpnConnection" IsEnabled="False" Style="{StaticResource VpnAction}" Background="White" Foreground="#101010" />
                  <Button x:Name="VpnDisconnectButton" Content="Desligar WARP" Tag="disconnect" Click="RequestVpnConnection" IsEnabled="False" Style="{StaticResource VpnAction}" />
