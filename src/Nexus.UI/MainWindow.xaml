                <ComboBox x:Name="LibraryDetected" DisplayMemberPath="Display" HorizontalAlignment="Stretch" AutomationProperties.Name="Aplicação detetada" />
                <Button Content="Rever e iniciar perfil" Click="StartLibrarySession" />
                <TextBlock Text="Balanceado, Competitivo, Streaming e Personalizado usam limites seguros próprios. A NEXUS não conhece os ajustes internos do TL. O perfil pode usar o plano disponível escolhido abaixo. Usa Terminar e repor ao acabar." TextWrapping="Wrap" Foreground="#9DA9AE" />
              </StackPanel>
            </Border>
            <Expander Header="Prioridade manual e definições do Windows" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
