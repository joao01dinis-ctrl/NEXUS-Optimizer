                <Button Content="Atualizar hardware e drivers" Click="RefreshExtendedHardware" />
                <Button Content="Consultar energia e planos disponíveis" Tag="optimize" Click="Navigate" />
                <Button Content="Preferências de GPU por aplicação" Tag="ms-settings:display-advancedgraphics" Click="OpenSetting" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource NexusCard}">
              <StackPanel Spacing="12">
                <TextBlock Text="GPU e jogos: escolher e medir" FontSize="21" FontWeight="SemiBold" />
                <TextBlock Text="NVIDIA Reflex deve ser configurado no jogo compatível. Testa um limite de FPS que o teu PC consiga sustentar. V-Sync, G-SYNC e Adaptive-Sync dependem do monitor, do driver e da prioridade entre fluidez e latência." TextWrapping="Wrap" />
                <TextBlock Text="A NEXUS não altera perfis globais NVIDIA. Usa a NVIDIA App ou o Painel de Controlo NVIDIA para opções não expostas por métodos suportados. Compara o mesmo cenário antes e depois." TextWrapping="Wrap" Foreground="#C3CBE0" />
                <TextBlock Text="Temperaturas, utilização GPU, VRAM e frequências GPU ainda não têm um fornecedor validado nesta revisão. Não são estimadas a partir do modelo do hardware." TextWrapping="Wrap" Foreground="#95A1BF" />
                <Button Content="Comparar capturas de FPS e frametimes" Tag="benchmark" Click="Navigate" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="GamingPanel" Visibility="Collapsed" Spacing="16">
            <Border Background="#171D2F" CornerRadius="14" Padding="22" BorderBrush="#2A3350" BorderThickness="1">
              <StackPanel Spacing="14">
                <TextBlock Text="Sessão com reposição" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Escolhe a aplicação aberta nesta secção. Quando ela terminar, o NEXUS repõe os ajustes desta sessão enquanto estiver aberto. Também podes terminar e repor manualmente." TextWrapping="Wrap" Foreground="#C3CBE0" />
                <ComboBox x:Name="LibraryProfiles" HorizontalAlignment="Stretch" AutomationProperties.Name="Perfil da sessão" />
                <ComboBox x:Name="GameList" HorizontalAlignment="Stretch" PlaceholderText="Selecionar aplicação aberta" AutomationProperties.Name="Aplicação a priorizar" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="Atualizar jogos abertos" Click="RefreshGames" />
                  <Button Content="Adicionar selecionado à biblioteca" Click="AddRunningLibraryApp" />
                </StackPanel>
                <CheckBox x:Name="SessionPriorityChoice" Content="Prioridade acima do normal durante a sessão" IsChecked="True" />
                <CheckBox x:Name="SessionAnimationsChoice" Content="Reduzir animações durante a sessão" />
                <CheckBox x:Name="SessionPowerChoice" Content="Usar outro plano de energia durante a sessão" />
                <ComboBox x:Name="SessionPlans" HorizontalAlignment="Stretch" PlaceholderText="Escolher plano disponível" AutomationProperties.Name="Plano da sessão" />
                <StackPanel Orientation="Horizontal" Spacing="12">
