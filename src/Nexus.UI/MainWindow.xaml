<Window x:Class="Nexus.UI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NEXUS Optimizer">
 <Grid x:Name="Root" RequestedTheme="Dark" Background="#0B1020">
  <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#111A2B" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Spacing="5" Margin="0,10,0,28"><TextBlock Text="NEXUS" FontSize="31" FontWeight="Bold" Foreground="#70E1CF"/><TextBlock Text="OPTIMIZER" CharacterSpacing="300" FontSize="10" Foreground="#A3B1CC"/></StackPanel>
   <StackPanel Grid.Row="1" Spacing="10"><Button Content="Visão geral" Tag="overview" Click="Navigate" HorizontalAlignment="Stretch"/><Button Content="Otimizar" Tag="optimize" Click="Navigate" HorizontalAlignment="Stretch"/><Button Content="Jogos" Tag="gaming" Click="Navigate" HorizontalAlignment="Stretch"/><Button Content="Memória" Tag="memory" Click="Navigate" HorizontalAlignment="Stretch"/><Button Content="Rede e DNS" Tag="network" Click="Navigate" HorizontalAlignment="Stretch"/><Button Content="Windows e limpeza" Tag="tools" Click="Navigate" HorizontalAlignment="Stretch"/><Button Content="Histórico e restauro" Tag="history" Click="Navigate" HorizontalAlignment="Stretch"/></StackPanel>
   <StackPanel Grid.Row="2" Spacing="8"><TextBlock Text="GRATUITO · SEM CONTA" FontSize="10" Foreground="#70E1CF"/><TextBlock Text="Tu escolhes o que muda." FontSize="12" Foreground="#A3B1CC" TextWrapping="Wrap"/><TextBlock Text="Versão 0.2 · experimental" FontSize="10" Foreground="#A3B1CC"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Column="1" Padding="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Spacing="6" Margin="0,0,0,20"><TextBlock x:Name="PageTitle" Text="O teu PC, sob controlo." FontSize="30" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" Foreground="#A3B1CC" TextWrapping="Wrap"/></StackPanel>
   <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="18">
     <StackPanel x:Name="OverviewPanel" Spacing="18">
      <Border Background="#182439" CornerRadius="16" Padding="22"><StackPanel Spacing="12"><TextBlock Text="Preparar. Jogar. Repor." FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Escolhe ajustes, vê o impacto e aplica. As alterações do NEXUS podem ser repostas no histórico." TextWrapping="Wrap" Foreground="#B8C6DD"/><Button Content="Escolher otimizações →" Tag="optimize" Click="Navigate" Style="{StaticResource AccentButtonStyle}"/></StackPanel></Border>
      <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Background="#141F32" CornerRadius="14" Padding="22"><StackPanel Spacing="10"><TextBlock Text="PROCESSADOR" Foreground="#A3B1CC"/><TextBlock Text="{Binding CpuText}" FontSize="42" FontWeight="SemiBold"/><ProgressBar Value="{Binding CpuPercent}" Foreground="#70E1CF"/><TextBlock Text="{Binding CpuName}" TextWrapping="Wrap"/></StackPanel></Border>
       <Border Grid.Column="1" Background="#141F32" CornerRadius="14" Padding="22"><StackPanel Spacing="10"><TextBlock Text="MEMÓRIA" Foreground="#A3B1CC"/><TextBlock Text="{Binding MemoryText}" FontSize="30" FontWeight="SemiBold"/><ProgressBar Value="{Binding MemoryPercent}" Foreground="#9C92FF"/><TextBlock Text="{Binding RamText}"/></StackPanel></Border>
      </Grid>
      <Border Background="#141F32" CornerRadius="14" Padding="22"><StackPanel Spacing="12"><TextBlock Text="O teu hardware" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding GpuName}" TextWrapping="Wrap"/><TextBlock Text="{Binding Disks}" TextWrapping="Wrap"/></StackPanel></Border>
      <Button Content="Analisar o PC" Click="Analyze"/><TextBlock x:Name="AnalysisText" Text="A análise é local e não altera definições." TextWrapping="Wrap" Foreground="#B8C6DD"/>
     </StackPanel>
     <StackPanel x:Name="OptimizePanel" Visibility="Collapsed" Spacing="18">
      <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Escolhe antes de aplicar" Message="Estes ajustes não garantem mais FPS. Energia de alto desempenho pode aumentar consumo, temperatura e ruído."/>
      <Border Background="#141F32" CornerRadius="14" Padding="22"><StackPanel Spacing="14"><CheckBox x:Name="PowerChoice" Content="Alterar plano de energia"/><TextBlock x:Name="CurrentPower" Text="A consultar planos disponíveis…" TextWrapping="Wrap" Foreground="#B8C6DD"/><ComboBox x:Name="PowerPlans" HorizontalAlignment="Stretch" AutomationProperties.Name="Plano de energia"/><TextBlock Text="Só são usados planos já disponíveis no teu PC. O plano anterior fica guardado para restauro." TextWrapping="Wrap" Foreground="#A3B1CC"/></StackPanel></Border>
      <Border Background="#141F32" CornerRadius="14" Padding="22"><StackPanel Spacing="14"><CheckBox x:Name="AnimationChoice" Content="Reduzir animações do Windows"/><TextBlock Text="Desativa animações das áreas de conteúdo em aplicações que respeitam esta opção. Pode tornar a navegação mais direta; não aumenta a capacidade da gráfica." TextWrapping="Wrap" Foreground="#B8C6DD"/></StackPanel></Border>
      <Border Background="#141F32" CornerRadius="14" Padding="22"><StackPanel Spacing="14"><TextBlock Text="Interface e teclado" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Preferências opcionais. Cada valor anterior fica guardado para restauro. Estas opções mudam a utilização do Windows; não são medições de desempenho." TextWrapping="Wrap" Foreground="#B8C6DD"/><StackPanel x:Name="PreferenceChoices" Spacing="14"/></StackPanel></Border>
      <Button x:Name="ApplySystemButton" Content="Rever e aplicar selecionados" Click="ApplySystem" Style="{StaticResource AccentButtonStyle}"/>
     </StackPanel>
     <StackPanel x:Name="GamingPanel" Visibility="Collapsed" Spacing="18">
      <Border Background="#141F32" CornerRadius="14" Padding="22"><StackPanel Spacing="14"><TextBlock Text="Dar prioridade ao teu jogo" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Abre o jogo e atualiza a lista. Escolhe a aplicação certa: o NEXUS dá prioridade de CPU acima do normal até ela fechar. Pode reduzir a fluidez de outras apps; não altera afinidade nem usa prioridade em tempo real." TextWrapping="Wrap" Foreground="#B8C6DD"/><ComboBox x:Name="GameList" HorizontalAlignment="Stretch" PlaceholderText="Selecionar aplicação aberta" AutomationProperties.Name="Aplicação a priorizar"/><StackPanel Orientation="Horizontal" Spacing="12"><Button Content="Atualizar lista" Click="RefreshGames"/><Button x:Name="PriorityButton" Content="Priorizar aplicação" Click="ApplyPriority" Style="{StaticResource AccentButtonStyle}"/></StackPanel><TextBlock Text="Mostra apps com janela e prioridade normal nesta sessão. Jogos protegidos podem recusar a alteração." TextWrapping="Wrap" Foreground="#A3B1CC"/></StackPanel></Border>
      <Border Background="#141F32" CornerRadius="14" Padding="22"><StackPanel Spacing="14"><TextBlock Text="Definições de jogo do Windows" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Confere o Modo de Jogo e escolhe a GPU por aplicação nas definições oficiais." TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="12"><Button Content="Modo de Jogo" Tag="ms-settings:gaming-gamemode" Click="OpenSetting"/><Button Content="Preferência de GPU" Tag="ms-settings:display-advancedgraphics" Click="OpenSetting"/></StackPanel></StackPanel></Border>
      <Border Background="#141F32" CornerRadius="14" Padding="22"><StackPanel Spacing="14"><TextBlock Text="Sessão com reposição" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Usa a aplicação selecionada acima. Quando ela terminar, o NEXUS repõe os ajustes desta sessão enquanto estiver aberto. Também podes terminar e repor manualmente." TextWrapping="Wrap" Foreground="#B8C6DD"/><CheckBox x:Name="SessionPriorityChoice" Content="Prioridade acima do normal durante a sessão" IsChecked="True"/><CheckBox x:Name="SessionPowerChoice" Content="Usar outro plano de energia durante a sessão"/><ComboBox x:Name="SessionPlans" HorizontalAlignment="Stretch" PlaceholderText="Escolher plano disponível" AutomationProperties.Name="Plano da sessão"/><StackPanel Orientation="Horizontal" Spacing="12"><Button x:Name="StartSessionButton" Content="Iniciar sessão" Click="StartSession" Style="{StaticResource AccentButtonStyle}"/><Button x:Name="EndSessionButton" Content="Terminar e repor" Click="EndSession"/></StackPanel><TextBlock x:Name="SessionStatusText" Text="Sem sessão ativa." TextWrapping="Wrap"/><TextBlock Text="Mantém o NEXUS aberto. Se fechares a app ou houver uma falha, o plano pode continuar aplicado: ao reabrir, usa Terminar e repor. Alterações externas à mesma definição podem impedir a reposição automática." TextWrapping="Wrap" Foreground="#A3B1CC"/></StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="MemoryPanel" Visibility="Collapsed" Spacing="18">
      <Border Background="#141F32" CornerRadius="14" Padding="22"><StackPanel Spacing="12"><TextBlock Text="Onde está a tua memória?" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Processos acessíveis da tua sessão, ordenados pela RAM residente. RAM em cache é reutilizada pelo Windows quando necessário. Fechar uma app que não precisas costuma ser mais útil do que esvaziar caches repetidamente." TextWrapping="Wrap" Foreground="#B8C6DD"/><StackPanel Orientation="Horizontal" Spacing="12"><Button Content="Atualizar utilização" Click="RefreshMemory"/><Button Content="Abrir Gestor de Tarefas" Tag="taskmgr.exe" Click="OpenTool"/></StackPanel><TextBlock x:Name="MemoryProcessesText" TextWrapping="Wrap" FontFamily="Consolas"/><TextBlock Text="RAM residente pode incluir páginas partilhadas entre processos. A memória privada é outra medida; a soma das linhas não é a RAM total do PC. O NEXUS não termina processos." TextWrapping="Wrap" Foreground="#A3B1CC"/></StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="NetworkPanel" Visibility="Collapsed" Spacing="18">
      <Border Background="#141F32" CornerRadius="14" Padding="22"><StackPanel Spacing="14"><TextBlock Text="Compara a resposta dos DNS" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Envia três consultas de example.com a cada fornecedor por UDP/IPv4. Vais contactar serviços externos; pode demorar alguns segundos. Mede a resolução de nomes nesta ligação, não o ping dos jogos. Não altera o DNS do PC." TextWrapping="Wrap" Foreground="#B8C6DD"/><StackPanel Orientation="Horizontal" Spacing="12"><Button x:Name="DnsButton" Content="Medir DNS" Click="MeasureDns" Style="{StaticResource AccentButtonStyle}"/><Button x:Name="CancelDnsButton" Content="Cancelar" Click="CancelDns" IsEnabled="False"/></StackPanel><TextBlock x:Name="DnsResultsText" Text="Ainda não há medições." TextWrapping="Wrap"/><Button Content="Configurar DNS nas definições do Windows" Tag="ms-settings:network-status" Click="OpenSetting"/><TextBlock Text="As definições externas não entram no restauro do NEXUS. Uma medição curta pode variar com o tráfego ou ser bloqueada pela rede." TextWrapping="Wrap" Foreground="#A3B1CC"/></StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="ToolsPanel" Visibility="Collapsed" Spacing="18">
      <Border Background="#141F32" CornerRadius="14" Padding="22"><StackPanel Spacing="14"><TextBlock Text="Rever temporários antigos" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Procura ficheiros na tua pasta temporária sem escrita ou acesso nos últimos 7 dias. Escolhe os ficheiros antes de os enviar à Lixeira. Não remove pastas nem segue ligações para outros locais." TextWrapping="Wrap" Foreground="#B8C6DD"/><Button x:Name="ScanTemporaryButton" Content="Analisar temporários" Click="ScanTemporary"/><TextBlock x:Name="TemporarySummaryText" Text="Ainda não há análise." TextWrapping="Wrap"/><ListView x:Name="TemporaryFiles" MaxHeight="320" SelectionMode="Multiple" AutomationProperties.Name="Temporários a enviar à Lixeira"><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap" FontSize="12" Margin="0,5"/></DataTemplate></ListView.ItemTemplate></ListView><Button x:Name="RecycleTemporaryButton" Content="Enviar selecionados à Lixeira" Click="RecycleTemporary" IsEnabled="False"/><TextBlock Text="Podes recuperar os ficheiros na Lixeira do Windows. O espaço continua ocupado até a esvaziares por tua decisão. Esta ação não entra no undo das definições do sistema." TextWrapping="Wrap" Foreground="#A3B1CC"/></StackPanel></Border>
      <TextBlock Text="Atalhos para ferramentas do Windows. As alterações feitas fora do NEXUS são geridas pelo Windows e não entram no nosso undo." TextWrapping="Wrap" Foreground="#B8C6DD"/>
      <Button Content="Limpar ficheiros temporários · Armazenamento" Tag="ms-settings:storagesense" Click="OpenSetting" HorizontalAlignment="Stretch"/>
      <Button Content="Reduzir apps que arrancam com o Windows" Tag="ms-settings:startupapps" Click="OpenSetting" HorizontalAlignment="Stretch"/>
      <Button Content="Ver utilização e fechar apps · Gestor de Tarefas" Tag="taskmgr.exe" Click="OpenTool" HorizontalAlignment="Stretch"/>
      <Button Content="Otimizar unidades · Ferramenta do Windows" Tag="dfrgui.exe" Click="OpenTool" HorizontalAlignment="Stretch"/>
      <Button Content="Pontos de restauro do Windows" Tag="SystemPropertiesProtection.exe" Click="OpenTool" HorizontalAlignment="Stretch"/>
      <Button Content="Definições de rede" Tag="ms-settings:network-status" Click="OpenSetting" HorizontalAlignment="Stretch"/>
      <Button Content="Atualizações e controladores" Tag="ms-settings:windowsupdate" Click="OpenSetting" HorizontalAlignment="Stretch"/>
      <TextBlock Text="Jogo e personalização" FontSize="20" FontWeight="SemiBold" Margin="0,10,0,0"/>
      <Button Content="Gravação em segundo plano e capturas" Tag="ms-settings:gaming-gamedvr" Click="OpenSetting" HorizontalAlignment="Stretch"/>
      <Button Content="Transparência e efeitos visuais" Tag="ms-settings:easeofaccess-visualeffects" Click="OpenSetting" HorizontalAlignment="Stretch"/>
      <Button Content="Teclas de aderência e acessibilidade do teclado" Tag="ms-settings:easeofaccess-keyboard" Click="OpenSetting" HorizontalAlignment="Stretch"/>
      <Button Content="Notificações e sugestões do Windows" Tag="ms-settings:notifications" Click="OpenSetting" HorizontalAlignment="Stretch"/>
      <Button Content="Barra de tarefas" Tag="ms-settings:taskbar" Click="OpenSetting" HorizontalAlignment="Stretch"/>
      <Button Content="Aplicações instaladas" Tag="ms-settings:appsfeatures" Click="OpenSetting" HorizontalAlignment="Stretch"/>
      <TextBlock Text="Privacidade" FontSize="20" FontWeight="SemiBold" Margin="0,10,0,0"/>
      <Button Content="Diagnóstico, feedback e experiências personalizadas" Tag="ms-settings:privacy-feedback" Click="OpenSetting" HorizontalAlignment="Stretch"/>
      <Button Content="Privacidade de pesquisa" Tag="ms-settings:search-permissions" Click="OpenSetting" HorizontalAlignment="Stretch"/>
      <Button Content="Permissões e recomendações de privacidade" Tag="ms-settings:privacy-general" Click="OpenSetting" HorizontalAlignment="Stretch"/>
      <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Segurança e compatibilidade" Message="SmartScreen, atualizações, recuperação e serviços essenciais são preservados. Os controlos do Windows acima permitem rever opções suportadas no teu PC."/>
     </StackPanel>
     <StackPanel x:Name="HistoryPanel" Visibility="Collapsed" Spacing="18">
      <Border Background="#141F32" CornerRadius="14" Padding="22"><StackPanel Spacing="12"><TextBlock Text="Alterações do Windows" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="O estado anterior é guardado antes de cada alteração. Desfaz uma de cada vez, da mais recente para a mais antiga. Se outra app alterar a mesma definição, o NEXUS avisa antes de a substituir." TextWrapping="Wrap" Foreground="#B8C6DD"/><Button x:Name="UndoSystemButton" Content="Desfazer última alteração do sistema" Click="UndoSystem"/><TextBlock x:Name="SystemHistory" TextWrapping="Wrap"/></StackPanel></Border>
      <Border Background="#141F32" CornerRadius="14" Padding="22"><StackPanel Spacing="12"><TextBlock Text="Ritmo de monitorização" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Estes perfis controlam só a frequência do dashboard: Normal 2s, Gaming 5s, Trabalho 3s." TextWrapping="Wrap" Foreground="#B8C6DD"/><ComboBox ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" Width="170"/><StackPanel Orientation="Horizontal" Spacing="12"><Button Content="Guardar ritmo" Command="{Binding ApplyProfileCommand}"/><Button Content="Desfazer ritmo" Command="{Binding UndoCommand}"/></StackPanel><TextBlock Text="{Binding History}" TextWrapping="Wrap"/></StackPanel></Border>
      <Border Background="#141F32" CornerRadius="14" Padding="22"><StackPanel Spacing="12"><TextBlock Text="Sessões de jogo" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="SessionHistoryText" TextWrapping="Wrap"/></StackPanel></Border>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
   <InfoBar x:Name="OperationInfo" Grid.Row="2" Margin="0,14,0,0" IsOpen="False" IsClosable="True" Severity="Success"/>
  </Grid>
 </Grid>
</Window>
