                </ListView>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="Adicionar executável" Click="AddLibraryApp" />
                  <Button Content="Retirar da biblioteca" Click="RemoveLibraryApp" />
                </StackPanel>
                <CheckBox x:Name="DiscoveryChoice" Content="Avisar sobre aplicações da biblioteca" />
