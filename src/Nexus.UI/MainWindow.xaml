              <StackPanel Spacing="14">
                <TextBlock Text="Aplicações nativas opcionais" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Lista limitada de aplicações opcionais. Store, segurança, shell e dependências não são selecionáveis. Desinstalar pode eliminar dados locais e fechar a app; guarda o que precisas. Não há remoção em massa nem undo." TextWrapping="Wrap" />
                <Button Content="Atualizar aplicações opcionais" Click="RefreshOptionalApps" />
                <ListView x:Name="OptionalAppList" MaxHeight="420" SelectionMode="Single" AutomationProperties.Name="Aplicações opcionais">
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Display}" Margin="0,6" />
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
                <Button Content="Rever remoção da selecionada" Click="RemoveOptionalApp" />
                <Button Content="Procurar selecionada na Store para reinstalar" Click="RestoreOptionalApp" />
                <TextBlock Text="A Store pede a instalação e pode exigir conta. Apps retiradas da Store podem não estar disponíveis; dados apagados não são recuperados pela reinstalação. Programas clássicos continuam nas Definições." TextWrapping="Wrap" Foreground="#95A1BF" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="LatencyPanel" Visibility="Collapsed" Spacing="18">
            <Border Background="#171D2F" CornerRadius="14" Padding="22" BorderBrush="#2A3350" BorderThickness="1">
              <StackPanel Spacing="14">
                <TextBlock Text="Latência e perda de rede" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Envia cinco pedidos ICMP ao IP que introduzires. O destino recebe os pedidos. Mede resposta de rede, não latência do rato/teclado, FPS ou o percurso real de cada jogo. Falta de resposta pode significar ICMP bloqueado." TextWrapping="Wrap" />
                <TextBox x:Name="LatencyAddress" PlaceholderText="IP do gateway ou do destino" AutomationProperties.Name="IP a testar" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button x:Name="LatencyButton" Content="Medir este destino" Click="MeasureLatency" />
                  <Button Content="Cancelar" Click="CancelLatency" />
                </StackPanel>
                <TextBlock x:Name="LatencyResultText" Text="Nenhuma medição executada." TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="CatalogPanel" Visibility="Collapsed" Spacing="18">
            <TextBlock Text="Cobertura e limites" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Lista de referência e estado de implementação. Não é uma lista de funções executáveis. O arranque da 0.5 foi confirmado; assinatura e paridade integral continuam pendentes." TextWrapping="Wrap" />
            <TextBox x:Name="FeatureSearch" PlaceholderText="Filtrar funções…" TextChanged="FilterFeatureCatalog" />
            <ListView x:Name="FeatureList" MaxHeight="550" SelectionMode="Single" AutomationProperties.Name="Catálogo de funções">
              <ListView.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Display}" TextWrapping="Wrap" Margin="0,8" />
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
            <Button Content="Abrir área da função selecionada" Click="OpenFeatureArea" />
          </StackPanel>
          <StackPanel x:Name="HistoryPanel" Visibility="Collapsed" Spacing="18">
            <Border Background="#171D2F" CornerRadius="14" Padding="22" BorderBrush="#2A3350" BorderThickness="1">
              <StackPanel Spacing="12">
                <TextBlock Text="Memória, rede, aplicações e limpeza" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Eventos registados localmente. Limpeza de cache, renovação IP, working sets e desinstalação não têm undo de definições. Os ficheiros reciclados são recuperados na Lixeira." TextWrapping="Wrap" />
                <TextBlock x:Name="ActivityHistoryText" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Background="#171D2F" CornerRadius="14" Padding="22" BorderBrush="#2A3350" BorderThickness="1">
              <StackPanel Spacing="12">
                <TextBlock Text="Cópia de segurança do histórico" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Guarda uma cópia SQLite completa com perfis, sessões, alterações e testes numa pasta que escolhas. Pode conter nomes de aplicações e valores anteriores. Guarda-a num local privado fora da pasta da app." TextWrapping="Wrap" />
                <Button Content="Escolher pasta e exportar cópia" Click="ExportBackup" />
                <TextBlock x:Name="BackupLocationText" TextWrapping="Wrap" />
                <TextBlock Text="Exportar não repõe ajustes. A importação automática ainda não está disponível. Não apagues a base de dados atual nem desinstales a app enquanto existirem ajustes por repor; usa o Histórico primeiro." TextWrapping="Wrap" Foreground="#95A1BF" />
              </StackPanel>
            </Border>
            <Border Background="#171D2F" CornerRadius="14" Padding="22" BorderBrush="#2A3350" BorderThickness="1">
              <StackPanel Spacing="12">
                <TextBlock Text="Alterações do Windows" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="O estado anterior é guardado antes de cada alteração. Desfaz uma de cada vez, da mais recente para a mais antiga. Se outra app alterar a mesma definição, o NEXUS avisa antes de a substituir." TextWrapping="Wrap" Foreground="#C3CBE0" />
                <Button x:Name="UndoSystemButton" Content="Desfazer última alteração do sistema" Click="UndoSystem" />
                <TextBlock x:Name="SystemHistory" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Background="#171D2F" CornerRadius="14" Padding="22" BorderBrush="#2A3350" BorderThickness="1">
              <StackPanel Spacing="12">
                <TextBlock Text="Ritmo de monitorização" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Estes perfis controlam só a frequência do dashboard: Normal 2s, Gaming 5s, Trabalho 3s." TextWrapping="Wrap" Foreground="#C3CBE0" />
                <ComboBox ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" Width="170" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Button Content="Guardar ritmo" Command="{Binding ApplyProfileCommand}" />
                  <Button Content="Desfazer ritmo" Command="{Binding UndoCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding History}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Background="#171D2F" CornerRadius="14" Padding="22" BorderBrush="#2A3350" BorderThickness="1">
              <StackPanel Spacing="12">
                <TextBlock Text="Sessões de jogo" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="SessionHistoryText" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Spacing="16" x:Name="TweaksPanel" Visibility="Collapsed">
            <Border Background="#171D2F" BorderBrush="#2A3350" BorderThickness="1" CornerRadius="14" Padding="20">
              <StackPanel Spacing="12">
                <TextBlock Text="Tweaks" FontSize="23" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBlock Text="Liga para aplicar. Desliga para recuperar o valor guardado pela NEXUS." FontSize="14" TextWrapping="Wrap" />
                <Button Content="Atualizar estados" Click="RefreshAdjustmentCards" />
              </StackPanel>
            </Border>
            <Grid RowSpacing="12" ColumnSpacing="12" x:Name="TweakCards" />
          </StackPanel>
          <StackPanel Spacing="16" x:Name="AutoCleanupPanel" Visibility="Collapsed">
            <Border Background="#171D2F" CornerRadius="14" Padding="22" BorderBrush="#2A3350" BorderThickness="1">
              <StackPanel Spacing="14">
                <TextBlock Text="Limpeza automática opcional" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Desligada em cada arranque. Apenas temporários antigos do utilizador, enviados à Lixeira; não esvazia a Lixeira nem limpa RAM/Prefetch. Suspende durante sessões e jogos/programas da biblioteca detetados. Outros jogos não identificados podem ser afetados pelo trabalho de disco." TextWrapping="Wrap" />
                <ComboBox x:Name="AutoCleanupInterval" SelectedIndex="1">
                  <ComboBoxItem Content="15 minutos" Tag="15" />
                  <ComboBoxItem Content="30 minutos" Tag="30" />
                  <ComboBoxItem Content="60 minutos" Tag="60" />
                </ComboBox>
                <Button Content="Executar agora" Click="ExecuteAutoCleanup" />
                <Button Content="Rever ativação / desligar" Click="EnableAutoCleanup" />
                <TextBlock x:Name="AutoCleanupStatus" Text="Desligada." TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Spacing="16" x:Name="TunerPanel" Visibility="Collapsed">
            <Border Background="#171D2F" BorderBrush="#2A3350" BorderThickness="1" CornerRadius="14" Padding="20">
              <StackPanel Spacing="12">
                <TextBlock Text="App Tuner" FontSize="23" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBlock Text="Prioridade de CPU para um programa aberto. O valor anterior fica no histórico." FontSize="14" TextWrapping="Wrap" />
                <ComboBox HorizontalAlignment="Stretch" PlaceholderText="Escolher programa aberto" DisplayMemberPath="Name" AutomationProperties.Name="Aplicação para App Tuner" x:Name="TunerProcessChoice" />
                <Button Content="Detetar programas" Click="RefreshTuner" />
                <Button Content="Otimizar selecionado" Click="ApplyTuner" Style="{StaticResource AccentButtonStyle}" />
                <Button Content="Repor ajustes de programas" Click="RestoreTuner" />
                <TextBlock Text="Nenhuma aplicação selecionada." FontSize="14" TextWrapping="Wrap" x:Name="TunerStatus" />
              </StackPanel>
            </Border>
            <Border Background="#171D2F" BorderBrush="#2A3350" BorderThickness="1" CornerRadius="14" Padding="20">
              <StackPanel Spacing="12">
                <TextBlock Text="Como funciona" FontSize="18" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBlock Text="Usa prioridade acima do normal; não modifica ficheiros ou controlos internos do programa. Processos protegidos podem recusar a alteração." FontSize="14" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="PrecisionPanel" Visibility="Collapsed" Spacing="18">
            <Border Style="{StaticResource NexusCard}">
              <StackPanel Spacing="12">
                <TextBlock Text="Velocidade do ponteiro do Windows" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="MouseSpeedText" Text="A consultar…" TextWrapping="Wrap" />
                <NumberBox x:Name="MouseSpeedValue" Header="Velocidade de 1 a 20" Minimum="1" Maximum="20" Value="10" SmallChange="1" SpinButtonPlacementMode="Compact" />
                <Button Content="Rever e aplicar velocidade" Click="ApplyMouseSpeed" />
                <Button Content="Repor velocidade anterior" Click="RestoreMouseSpeed" />
                <TextBlock Text="DPI é a resolução do sensor; polling é a frequência de comunicação; esta velocidade controla o ponteiro do Windows. A sensibilidade do jogo é outra definição. Raw Input pode ignorar velocidade e aceleração do Windows. Não alteramos a energia USB de forma genérica." TextWrapping="Wrap" Foreground="#95A1BF" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource NexusCard}">
              <StackPanel Spacing="12">
                <TextBlock Text="Movimentos consistentes. Escolhas claras." FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="Ajusta o ponteiro do Windows e calcula a sensibilidade ao mudar de DPI. As alterações do rato são sempre manuais e ficam no Histórico." TextWrapping="Wrap" Foreground="#C3CBE0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource NexusCard}">
              <StackPanel Spacing="14">
                <TextBlock Text="Aceleração do ponteiro" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="MouseStateText" Text="Consulta o estado atual do rato." TextWrapping="Wrap" />
                <TextBlock Text="Desligar a aceleração torna o movimento do ponteiro mais previsível. Jogos com Raw Input podem ignorar esta preferência. Não altera DPI, polling, ficheiros do jogo nem a precisão do sensor." Foreground="#95A1BF" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="Desligar aceleração" Click="DisableMouseAcceleration" Style="{StaticResource AccentButtonStyle}" />
                  <Button Content="Repor valor anterior" Click="RestoreMouseAcceleration" />
                  <Button Content="Atualizar" Click="RefreshMousePrecision" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource NexusCard}">
              <StackPanel Spacing="14">
                <TextBlock Text="Mudar de DPI sem perder a referência" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="Calcula uma sensibilidade equivalente no mesmo jogo e com a mesma escala linear. Não lê nem altera configurações do jogo." Foreground="#C3CBE0" TextWrapping="Wrap" />
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <NumberBox x:Name="OriginalDpiBox" Header="DPI atual" Value="800" Minimum="50" Maximum="100000" SpinButtonPlacementMode="Compact" />
                  <NumberBox Grid.Column="1" x:Name="OriginalSensitivityBox" Header="Sensibilidade atual" Value="1" Minimum="0.001" Maximum="1000" />
                  <NumberBox Grid.Column="2" x:Name="NewDpiBox" Header="Novo DPI" Value="1600" Minimum="50" Maximum="100000" SpinButtonPlacementMode="Compact" />
                </Grid>
                <Button Content="Calcular sensibilidade" Click="CalculateSensitivity" />
                <TextBlock x:Name="SensitivityResult" Text="Introduz os valores e calcula. A escala tem de ser a mesma no jogo." TextWrapping="Wrap" Foreground="#B5A4FF" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource NexusCard}">
              <StackPanel Spacing="12">
                <TextBlock Text="FiveM e latência" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Usa uma sessão reversível e compara capturas no mesmo servidor e cenário. A NEXUS não injeta no jogo nem altera o anti-cheat." TextWrapping="Wrap" Foreground="#C3CBE0" />
                <Button Content="Abrir Jogos e FiveM" Tag="gaming" Click="Navigate" />
                <Button Content="Medir FPS e frametimes" Tag="benchmark" Click="Navigate" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Spacing="18">
            <Border Style="{StaticResource NexusCard}">
              <StackPanel Spacing="14">
                <TextBlock Text="A NEXUS à tua maneira" FontSize="24" FontWeight="SemiBold" />
                <ToggleSwitch x:Name="LightThemeToggle" Header="Aparência clara" Toggled="ThemeChanged" OnContent="Clara" OffContent="Escura" />
                <ToggleSwitch x:Name="ResourceSavingToggle" Header="Modo leve" Toggled="ResourceModeChanged" OnContent="Atualizar a cada 10 segundos" OffContent="Monitorização normal" />
                <TextBlock Text="O modo leve reduz as atualizações e o desenho de gráficos. Não força a limpeza da RAM nem interfere com outras aplicações." TextWrapping="Wrap" Foreground="#95A1BF" />
                <Button Content="Gerir aplicações de arranque no Windows" Tag="ms-settings:startupapps" Click="OpenSetting" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource NexusCard}">
              <StackPanel Spacing="14">
                <TextBlock Text="Otimização automática" FontSize="20" FontWeight="SemiBold" />
                <ToggleSwitch x:Name="AutoSafeToggle" Header="Analisar periodicamente enquanto a NEXUS está aberta" Toggled="AutoSafeChanged" OnContent="Ativo nesta sessão" OffContent="Desligado" />
                <TextBlock x:Name="AutoSafeStatus" Text="Desligado. Ao ativar, analisa a cada 15 minutos e só aplica os cinco efeitos visuais permitidos se observar pressão sustentada. Não reaplica alterações que tenhas mudado fora da NEXUS." TextWrapping="Wrap" Foreground="#95A1BF" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource NexusCard}">
              <StackPanel Spacing="14">
                <TextBlock Text="Consultor OpenAI · opcional" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="AiConnectionStatus" Text="A verificar configuração…" TextWrapping="Wrap" />
                <ToggleSwitch x:Name="AiUseToggle" Header="Usar OpenAI na análise que eu iniciar" OnContent="Enviar resumo limitado" OffContent="Só análise local" />
                <TextBlock Text="Ao ativar e iniciar uma análise, envias à OpenAI percentagens de CPU/RAM, quantidade de RAM, estado da bateria, número de discos com pouco espaço e os identificadores dos efeitos visuais permitidos. Não envia nomes de processos, ficheiros, IPs ou identificadores do PC. O uso da API pode ter custos. As análises periódicas são sempre locais." TextWrapping="Wrap" Foreground="#95A1BF" />
                <TextBlock Text="A IA explica os dados e pode sugerir apenas os ajustes já autorizados pelas regras locais. Nunca executa comandos. Sem chave, sem ligação ou sem saldo, a análise local continua disponível." TextWrapping="Wrap" Foreground="#C3CBE0" />
                <TextBox x:Name="AiModelBox" Header="Modelo OpenAI" Text="gpt-4.1-mini" MaxLength="80" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource NexusCard}">
              <StackPanel Spacing="12">
                <TextBlock Text="Segurança gerida pelo Windows" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="A NEXUS não substitui o antivírus. Não bloqueia processos por adivinhação, não desliga proteções e não promete proteção contra malware. Usa a Segurança do Windows para verificar o estado e analisar ficheiros." TextWrapping="Wrap" Foreground="#C3CBE0" />
                <Button Content="Abrir Segurança do Windows" Tag="windowsdefender:" Click="OpenSetting" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Spacing="16" x:Name="HelpPanel" Visibility="Collapsed">
            <Border Background="#171D2F" BorderBrush="#2A3350" BorderThickness="1" CornerRadius="14" Padding="20">
              <StackPanel Spacing="12">
                <TextBlock Text="Começar a usar" FontSize="23" TextWrapping="Wrap" FontWeight="SemiBold" />
                <Button Content="Primeiros passos — guia opcional" Click="ShowQuickGuide" />
                <TextBlock Text="1. PC Boost: analisa e aplica a seleção.&#10;2. Game Mode: escolhe um perfil e ativa o acompanhamento.&#10;3. Tweaks: aplica opções individualmente.&#10;4. Histórico: repõe os valores anteriores." FontSize="14" TextWrapping="Wrap" />
                <Button Content="Ver testes e FPS" Tag="benchmark" Click="Navigate" />
                <Button Content="Ver cobertura da referência" Tag="catalog" Click="Navigate" />
              </StackPanel>
            </Border>
            <Border Background="#171D2F" BorderBrush="#2A3350" BorderThickness="1" CornerRadius="14" Padding="20">
              <StackPanel Spacing="12">
                <TextBlock Text="Funções que dependem do Windows" FontSize="18" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBlock Text="As opções externas são identificadas. Ajustes ocultos no TL e opções que retiram segurança não são apresentados como implementados." FontSize="14" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <InfoBar x:Name="OperationInfo" Grid.Row="2" Margin="0,14,0,0" IsOpen="False" IsClosable="True" Severity="Success" />
    </Grid>
  </Grid>
</Window>
