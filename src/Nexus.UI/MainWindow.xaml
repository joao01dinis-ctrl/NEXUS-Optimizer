<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Nexus.UI.MainWindow" Title="NEXUS Optimizer">
  <Grid x:Name="Root" RequestedTheme="Dark" Background="#0C0F1A">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="218" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Background="#111525" Padding="14">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4" Margin="10,8,0,22">
          <TextBlock Text="NEXUS" FontSize="27" TextWrapping="Wrap" FontWeight="Bold" Foreground="#B5A4FF" />
          <TextBlock Text="OPTIMIZER" FontSize="10" TextWrapping="Wrap" CharacterSpacing="240" Foreground="#95A1BF" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="6" x:Name="NavigationButtons">
            <StackPanel x:Name="FavoriteNavigation" Spacing="4" Visibility="Collapsed" />
            <TextBlock Text="O TEU ESPAÇO" FontSize="10" Margin="12,0,0,10" CharacterSpacing="160" Foreground="#8390AE" />
            <Button Tag="overview" Click="Navigate" Style="{StaticResource NexusNavigationButton}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="" FontSize="17" />
                <TextBlock Text="Início" FontSize="14" />
              </StackPanel>
            </Button>
            <Button Tag="optimize" Click="Navigate" Style="{StaticResource NexusNavigationButton}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="" FontSize="17" />
                <TextBlock Text="Otimizar" FontSize="14" />
              </StackPanel>
            </Button>
            <Button Tag="library" Click="Navigate" Style="{StaticResource NexusNavigationButton}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE7FC;" FontSize="17" />
                <TextBlock Text="Os meus jogos" FontSize="14" />
              </StackPanel>
            </Button>
            <Button Tag="gaming" Click="Navigate" Style="{StaticResource NexusNavigationButton}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="" FontSize="17" />
                <TextBlock Text="Game Boost" FontSize="14" />
              </StackPanel>
            </Button>
            <Button Tag="protection" Click="Navigate" Style="{StaticResource NexusNavigationButton}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE83D;" FontSize="17" />
                <TextBlock Text="Proteção do PC" FontSize="14" />
              </StackPanel>
            </Button>
            <Button Tag="precision" Click="Navigate" Style="{StaticResource NexusNavigationButton}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="" FontSize="17" />
                <TextBlock Text="Rato e precisão" FontSize="14" />
              </StackPanel>
            </Button>
            <Button Tag="history" Click="Navigate" Style="{StaticResource NexusNavigationButton}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="" FontSize="17" />
                <TextBlock Text="Histórico" FontSize="14" />
              </StackPanel>
            </Button>
            <Expander Header="Mais ferramentas" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,18,0,0">
              <StackPanel x:Name="AdvancedNavigationButtons" Spacing="4">
                <Button Tag="hardware" Click="Navigate" Style="{StaticResource NexusNavigationButton}" Content="Hardware e GPU" />
                <Button Tag="vpn" Click="Navigate" Style="{StaticResource NexusNavigationButton}" Content="Nexos VPN" />
                <Button Tag="tweaks" Click="Navigate" Style="{StaticResource NexusNavigationButton}">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="" FontSize="17" />
                    <TextBlock Text="Ajustes visuais" FontSize="14" />
                  </StackPanel>
                </Button>
                <Button Tag="memory" Click="Navigate" Style="{StaticResource NexusNavigationButton}">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="" FontSize="17" />
                    <TextBlock Text="CPU e memória" FontSize="14" />
                  </StackPanel>
                </Button>
                <Button Tag="network" Click="Navigate" Style="{StaticResource NexusNavigationButton}">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="" FontSize="17" />
                    <TextBlock Text="Rede e DNS" FontSize="14" />
                  </StackPanel>
                </Button>
                <Button Tag="latency" Click="Navigate" Style="{StaticResource NexusNavigationButton}">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="" FontSize="17" />
                    <TextBlock Text="Testar ligação" FontSize="14" />
                  </StackPanel>
                </Button>
                <Button Tag="autoclean" Click="Navigate" Style="{StaticResource NexusNavigationButton}">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="" FontSize="17" />
                    <TextBlock Text="Limpeza" FontSize="14" />
                  </StackPanel>
                </Button>
                <Button Tag="benchmark" Click="Navigate" Style="{StaticResource NexusNavigationButton}">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="" FontSize="17" />
                    <TextBlock Text="Testes e FPS" FontSize="14" />
                  </StackPanel>
                </Button>
                <Button Tag="tuner" Click="Navigate" Style="{StaticResource NexusNavigationButton}">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="" FontSize="17" />
                    <TextBlock Text="Aplicações" FontSize="14" />
                  </StackPanel>
                </Button>
                <Button Tag="preferences" Click="Navigate" Style="{StaticResource NexusNavigationButton}">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="" FontSize="17" />
                    <TextBlock Text="Windows" FontSize="14" />
                  </StackPanel>
                </Button>
                <Button Tag="tools" Click="Navigate" Style="{StaticResource NexusNavigationButton}">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="" FontSize="17" />
                    <TextBlock Text="Ferramentas" FontSize="14" />
                  </StackPanel>
                </Button>
                <Button Tag="catalog" Click="Navigate" Style="{StaticResource NexusNavigationButton}">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="" FontSize="17" />
                    <TextBlock Text="Todas as funções" FontSize="14" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Expander>
            <Border Height="1" Background="#2A3350" Margin="6,18,6,10" />
            <Button Tag="settings" Click="Navigate" Style="{StaticResource NexusNavigationButton}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="" FontSize="17" />
                <TextBlock Text="Preferências e IA" FontSize="14" />
              </StackPanel>
            </Button>
            <Button Tag="help" Click="Navigate" Style="{StaticResource NexusNavigationButton}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="" FontSize="17" />
                <TextBlock Text="Ajuda" FontSize="14" />
              </StackPanel>
            </Button>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Spacing="6" Margin="10,12,0,0">
          <TextBlock Text="NEXUS · SEM SUBSCRIÇÃO" FontSize="10" TextWrapping="Wrap" Foreground="#B5A4FF" />
          <TextBlock Text="0.10 · pré-visualização" FontSize="11" TextWrapping="Wrap" Foreground="#95A1BF" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Padding="26,22,26,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Spacing="10" Margin="0,0,0,18">
        <AutoSuggestBox x:Name="QuickSearch" PlaceholderText="Pesquisar funções e páginas…" TextMemberPath="Title" TextChanged="SearchChanged" QuerySubmitted="SearchSubmitted" AutomationProperties.Name="Pesquisar páginas e funções" />
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock x:Name="PageTitle" Text="Início" FontSize="28" FontWeight="SemiBold" />
          <Button Grid.Column="1" x:Name="FavoritePageButton" Content="Guardar favorito" Click="ToggleFavoritePage" VerticalAlignment="Center" />
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Content="Desfazer alterações" Click="RestoreEverything" />
          <TextBlock Text="Nenhuma alteração por repor" FontSize="12" TextWrapping="Wrap" Foreground="#95A1BF" x:Name="GlobalChangeStatus" />
        </StackPanel>
      </StackPanel>
      <ScrollViewer x:Name="PageScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="18">
          <StackPanel x:Name="OverviewPanel" Spacing="18">
            <Border CornerRadius="20" Padding="22" BorderBrush="#494063" BorderThickness="1" RequestedTheme="Dark">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#302947" Offset="0" />
                  <GradientStop Color="#1C2440" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Glyph="" FontSize="14" Foreground="#B5A4FF" />
                  <TextBlock Text="NEXUS INTELLIGENCE" Foreground="#D7CCFF" FontSize="11" CharacterSpacing="180" />
                </StackPanel>
                <TextBlock Text="Menos ajustes. Mais controlo." FontSize="29" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#F5F4FF" />
                <TextBlock Text="O teu PC analisado em segundos. A NEXUS aplica apenas preferências visuais reversíveis quando os dados as justificam." MaxWidth="660" HorizontalAlignment="Left" FontSize="15" TextWrapping="Wrap" Foreground="#D4D7EA" />
                <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2">
                  <Button x:Name="HomeOptimizeButton" Content="Otimizar o meu PC" Click="SmartOptimize" Style="{StaticResource AccentButtonStyle}" Padding="22,12" Margin="0,0,10,8" />
                  <Button x:Name="HomeAnalyzeButton" Content="Só analisar" Click="SmartAnalyze" Padding="20,12" Margin="0,0,0,8" />
                </VariableSizedWrapGrid>
                <ProgressBar x:Name="AssistantProgress" IsIndeterminate="True" Visibility="Collapsed" />
                <TextBlock x:Name="AssistantSummary" Text="Pronto para analisar. Ainda não foi alterada nenhuma definição." Foreground="#D4D7EA" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="AssistantEvidence" Text="5 amostras reais · histórico antes de aplicar · desfazer em qualquer altura" Foreground="#B8BED7" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <TextBlock Text="O PC EM TEMPO REAL" Foreground="#95A1BF" FontSize="11" CharacterSpacing="160" Margin="2,6,0,0" />
            <TextBlock x:Name="UptimeText" TextWrapping="Wrap" Foreground="#95A1BF" />
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Border Background="#171D2F" CornerRadius="14" Padding="22" BorderBrush="#2A3350" BorderThickness="1">
                <StackPanel Spacing="10">
                  <TextBlock Text="PROCESSADOR" Foreground="#95A1BF" />
                  <TextBlock Text="{Binding CpuText}" FontSize="42" FontWeight="SemiBold" />
                  <ProgressBar Value="{Binding CpuPercent}" Foreground="#B5A4FF" />
                  <Canvas x:Name="CpuGraph" Height="60" HorizontalAlignment="Stretch">
                    <Polyline x:Name="CpuLine" Stroke="#B5A4FF" StrokeThickness="2" />
                  </Canvas>
                  <TextBlock Text="{Binding CpuName}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Background="#171D2F" CornerRadius="14" Padding="22" BorderBrush="#2A3350" BorderThickness="1">
                <StackPanel Spacing="10">
                  <TextBlock Text="MEMÓRIA" Foreground="#95A1BF" />
                  <TextBlock Text="{Binding MemoryText}" FontSize="30" FontWeight="SemiBold" />
                  <ProgressBar Value="{Binding MemoryPercent}" Foreground="#83C2D5" />
                  <Canvas x:Name="MemoryGraph" Height="60" HorizontalAlignment="Stretch">
                    <Polyline x:Name="MemoryLine" Stroke="#83C2D5" StrokeThickness="2" />
                  </Canvas>
                  <TextBlock Text="{Binding RamText}" />
                </StackPanel>
              </Border>
            </Grid>
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Button Tag="gaming" Click="Navigate" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="18" CornerRadius="12">
                <StackPanel Spacing="7">
                  <FontIcon Glyph="" HorizontalAlignment="Left" Foreground="#B5A4FF" />
                  <TextBlock Text="Jogar FiveM" FontWeight="SemiBold" />
                  <TextBlock Text="Sessão e restauro" FontSize="12" TextWrapping="Wrap" Opacity="0.7" />
                </StackPanel>
              </Button>
              <Button Grid.Column="1" Tag="precision" Click="Navigate" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="18" CornerRadius="12">
                <StackPanel Spacing="7">
                  <FontIcon Glyph="" HorizontalAlignment="Left" Foreground="#88BDF5" />
                  <TextBlock Text="Rato e precisão" FontWeight="SemiBold" />
                  <TextBlock Text="Consistência ao mover" FontSize="12" TextWrapping="Wrap" Opacity="0.7" />
                </StackPanel>
              </Button>
              <Button Grid.Column="2" Tag="benchmark" Click="Navigate" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="18" CornerRadius="12">
                <StackPanel Spacing="7">
                  <FontIcon Glyph="" HorizontalAlignment="Left" Foreground="#B5A4FF" />
                  <TextBlock Text="Medir resultados" FontWeight="SemiBold" />
                  <TextBlock Text="Comparar antes e depois" FontSize="12" TextWrapping="Wrap" Opacity="0.7" />
                </StackPanel>
              </Button>
            </Grid>
            <Border Background="#171D2F" CornerRadius="14" Padding="22" BorderBrush="#2A3350" BorderThickness="1">
              <StackPanel Spacing="12">
                <TextBlock Text="O teu hardware" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding GpuName}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Disks}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding Status}" Foreground="#95A1BF" TextWrapping="Wrap" />
            <Expander Header="Recomendações e ajustes que mudaram" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="12">
                <Border Background="#171D2F" CornerRadius="14" Padding="22" BorderBrush="#2A3350" BorderThickness="1">
                  <StackPanel Spacing="14">
                    <TextBlock Text="Conferir ajustes que mudaram" FontSize="20" FontWeight="SemiBold" />
                    <Button Content="Verificar últimos ajustes aplicados" Click="CheckDrift" />
                    <TextBlock x:Name="DriftSummary" Text="Compara os últimos valores guardados, sem os reaplicar." TextWrapping="Wrap" />
                    <ListView x:Name="DriftList" MaxHeight="240" SelectionMode="Single">
                      <ListView.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Display}" TextWrapping="Wrap" Margin="0,6" />
                        </DataTemplate>
                      </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="Rever reaplicação do selecionado" Click="ReapplyDrift" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Expander>
            <Expander Header="Estado da análise local" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="12">
                <TextBlock x:Name="AnalysisText" Text="A análise é local e não altera definições." TextWrapping="Wrap" Foreground="#C3CBE0" />
              </StackPanel>
            </Expander>
          </StackPanel>
          <StackPanel x:Name="OptimizePanel" Visibility="Collapsed" Spacing="16">
            <Border Background="#171D2F" BorderBrush="#2A3350" BorderThickness="1" CornerRadius="14" Padding="20">
              <StackPanel Spacing="12">
                <TextBlock Text="Otimização inteligente" FontSize="23" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBlock Text="1. Analisar o PC   2. Aplicar apenas o que faz sentido   3. Comparar e desfazer" FontSize="14" TextWrapping="Wrap" />
                <Button x:Name="QuickOptimizeButton" Content="Analisar e otimizar automaticamente" Click="SmartOptimize" Style="{StaticResource AccentButtonStyle}" />
                <TextBlock Text="O automático só pode reduzir cinco efeitos visuais com pressão sustentada de CPU ou RAM. Energia, rato, processos, ficheiros e segurança ficam fora deste modo." TextWrapping="Wrap" FontSize="12" Foreground="#95A1BF" />
                <ComboBox x:Name="OptimizationPresetList" HorizontalAlignment="Stretch" AutomationProperties.Name="Perfil de seleção" Header="Objetivo" SelectionChanged="BoostPresetChanged" />
                <Button x:Name="AnalyzeBoostButton" Content="Analisar para escolher manualmente" Click="AnalyzeBoost" />
                <TextBlock Text="Clica em Analisar para preparar a seleção." FontSize="14" TextWrapping="Wrap" x:Name="BoostStatus" />
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button x:Name="CancelBoostButton" Content="Cancelar análise" Click="CancelBoost" IsEnabled="False" />
              <Button Content="Exportar diagnóstico" Click="ExportBoostReport" />
            </StackPanel>
            <StackPanel Spacing="10" x:Name="BoostChoices" />
            <Expander Header="Diagnóstico e recomendações" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="16">
                <TextBlock x:Name="BoostHardwareText" Text="Analisa o PC para consultar hardware e amostras." TextWrapping="Wrap" />
                <StackPanel x:Name="BoostAdvice" Spacing="18" />
              </StackPanel>
            </Expander>
            <Button Content="Aplicar seleção" Click="ApplyBoost" Style="{StaticResource AccentButtonStyle}" x:Name="ApplyBoostButton" IsEnabled="False" />
            <Expander Header="Escolher ajustes manualmente" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="12">
                <Border Background="#171D2F" CornerRadius="14" Padding="22" BorderBrush="#2A3350" BorderThickness="1">
                  <StackPanel Spacing="14">
                    <TextBlock Text="Preparar uma seleção" FontSize="20" FontWeight="SemiBold" />
                    <Button Content="Preparar seleção do perfil" Click="ChoosePreset" />
                    <TextBlock x:Name="PresetDescription" Text="Escolhe Balanceado, Competitivo ou Streaming. A seleção não aplica alterações automaticamente; revê os ajustes abaixo." TextWrapping="Wrap" Foreground="#C3CBE0" />
                  </StackPanel>
                </Border>
                <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Escolhe antes de aplicar" Message="Estes ajustes não garantem mais FPS. Energia de alto desempenho pode aumentar consumo, temperatura e ruído." />
                <Border Background="#171D2F" CornerRadius="14" Padding="22" BorderBrush="#2A3350" BorderThickness="1">
                  <StackPanel Spacing="14">
                    <CheckBox x:Name="PowerChoice" Content="Alterar plano de energia" />
                    <TextBlock x:Name="CurrentPower" Text="A consultar planos disponíveis…" TextWrapping="Wrap" Foreground="#C3CBE0" />
                    <ComboBox x:Name="PowerPlans" HorizontalAlignment="Stretch" AutomationProperties.Name="Plano de energia" />
                    <TextBlock Text="Só são usados planos já disponíveis no teu PC. O plano anterior fica guardado para restauro." TextWrapping="Wrap" Foreground="#95A1BF" />
                  </StackPanel>
                </Border>
                <Border Background="#171D2F" CornerRadius="14" Padding="22" BorderBrush="#2A3350" BorderThickness="1">
                  <StackPanel Spacing="14">
                    <CheckBox x:Name="AnimationChoice" Content="Reduzir animações do Windows" />
                    <TextBlock Text="Desativa animações das áreas de conteúdo em aplicações que respeitam esta opção. Pode tornar a navegação mais direta; não aumenta a capacidade da gráfica." TextWrapping="Wrap" Foreground="#C3CBE0" />
                  </StackPanel>
                </Border>
                <Border Background="#171D2F" CornerRadius="14" Padding="22" BorderBrush="#2A3350" BorderThickness="1">
                  <StackPanel Spacing="14">
                    <TextBlock Text="Interface e teclado" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Preferências opcionais. Cada valor anterior fica guardado para restauro. Estas opções mudam a utilização do Windows; não são medições de desempenho." TextWrapping="Wrap" Foreground="#C3CBE0" />
                    <StackPanel x:Name="PreferenceChoices" Spacing="14" />
                  </StackPanel>
                </Border>
                <Button x:Name="ApplySystemButton" Content="Rever e aplicar selecionados" Click="ApplySystem" Style="{StaticResource AccentButtonStyle}" />
              </StackPanel>
            </Expander>
          </StackPanel>
          <StackPanel x:Name="InstalledGamesPanel" Visibility="Collapsed" Spacing="18">
            <Border Style="{StaticResource NexusCard}">
              <StackPanel Spacing="12">
                <TextBlock Text="Os teus jogos, num só lugar" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="A NEXUS lê as bibliotecas acessíveis deste PC. Guarda um perfil por jogo e revê os ajustes antes de iniciar. Os ficheiros dos jogos e o anti-cheat ficam intactos." TextWrapping="Wrap" Foreground="#C3CBE0" />
                <Button x:Name="InstalledScanButton" Content="Procurar jogos instalados" Click="ScanInstalledGames" />
                <TextBlock x:Name="InstalledGamesStatus" Text="A biblioteca será procurada automaticamente ao abrir a NEXUS." TextWrapping="Wrap" />
                <Button Content="Ativar / pausar Game Boost dos meus jogos" Click="TogglePerGameAutomation" Style="{StaticResource AccentButtonStyle}" />
                <TextBlock Text="As escolhas por jogo ficam guardadas. A autorização de execução automática é confirmada nesta abertura; novos jogos não são incluídos sem escolha." TextWrapping="Wrap" Foreground="#95A1BF" />
              </StackPanel>
            </Border>
            <StackPanel x:Name="InstalledGameCards" Spacing="14" />
            <Expander Header="Os teus perfis e importação" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="12">
                <TextBlock Text="Padrão acompanha a sessão. Competitivo reduz duas animações. Máximo permite cinco preferências visuais. Nenhum perfil fecha programas, altera o jogo ou garante mais FPS." TextWrapping="Wrap" />
                <TextBox x:Name="CustomProfileName" Header="Nome do perfil personalizado" MaxLength="60" />
                <ComboBox x:Name="CustomProfileTemplate" Header="Preferências a guardar" HorizontalAlignment="Stretch" />
                <Button Content="Guardar o meu perfil" Click="SaveCustomGameProfile" />
                <Button Content="Exportar perfil personalizado ou modelo escolhido" Click="ExportGameProfile" />
                <Button Content="Importar perfil" Click="ImportGameProfile" />
                <TextBlock Text="Importar só guarda preferências visuais compatíveis. Não executa comandos, não aplica ajustes e não ativa o automático." TextWrapping="Wrap" Foreground="#95A1BF" />
              </StackPanel>
            </Expander>
            <Button Content="Deteção manual e sessões avançadas" Tag="gaming" Click="Navigate" />
          </StackPanel>
          <StackPanel x:Name="ProtectionPanel" Visibility="Collapsed" Spacing="18">
            <Border Style="{StaticResource NexusCard}">
              <StackPanel Spacing="14">
                <TextBlock Text="Proteção com Microsoft Defender" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="A proteção antivírus é fornecida pelo Windows. A NEXUS reúne o estado e os pedidos de análise num só lugar." TextWrapping="Wrap" Foreground="#C3CBE0" />
                <InfoBar x:Name="ProtectionState" IsOpen="True" IsClosable="False" Severity="Informational" Title="Estado comunicado pelo Windows" Message="A consultar a proteção deste PC…" />
                <TextBlock x:Name="ProtectionDetails" Text="Os dados serão apresentados depois da consulta local." TextWrapping="Wrap" />
                <TextBlock x:Name="ProtectionCheckedAt" Text="Ainda sem consulta concluída." TextWrapping="Wrap" Foreground="#95A1BF" />
                <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2">
                  <Button Content="Abrir Segurança do Windows" Click="OpenWindowsProtection" Style="{StaticResource AccentButtonStyle}" Margin="0,0,10,8" />
                  <Button x:Name="ProtectionRefreshButton" Content="Atualizar estado" Click="RefreshProtection" Margin="0,0,0,8" />
                </VariableSizedWrapGrid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource NexusCard}">
              <StackPanel Spacing="12">
                <TextBlock Text="Analisar e atualizar" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="ProtectionPermissions" Text="A disponibilidade depende do fornecedor ativo, dos direitos e das políticas deste PC." TextWrapping="Wrap" Foreground="#C3CBE0" />
                <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3">
                  <Button x:Name="ProtectionQuickButton" Content="Análise rápida" Tag="QuickScan" Click="RequestProtectionAction" IsEnabled="False" Margin="0,0,10,8" />
                  <Button x:Name="ProtectionFullButton" Content="Análise completa" Tag="FullScan" Click="RequestProtectionAction" IsEnabled="False" Margin="0,0,10,8" />
