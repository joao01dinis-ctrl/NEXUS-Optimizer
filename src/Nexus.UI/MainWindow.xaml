<Window x:Class="Nexus.UI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NEXUS Optimizer">
 <Grid x:Name="Root" RequestedTheme="Dark" Background="#0C101B"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border Background="#121827" Padding="24"><StackPanel Spacing="24"><StackPanel><TextBlock Text="NEXUS" FontSize="30" FontWeight="Bold" Foreground="#74D9CF"/><TextBlock Text="OPTIMIZER" CharacterSpacing="300" FontSize="11" Foreground="#99A9C1"/></StackPanel><Border Background="#24364B" CornerRadius="8" Padding="14"><TextBlock Text="◉   Dashboard" FontWeight="SemiBold"/></Border><TextBlock Text="PRIMEIRA VERSÃO" FontSize="11" Foreground="#99A9C1"/><TextBlock Text="Hardware e monitorização" TextWrapping="Wrap"/><TextBlock Text="Perfis e histórico"/><TextBlock Text="Undo de preferências"/><Border Background="#162F30" CornerRadius="8" Padding="12"><TextBlock Text="Sem tweaks de sistema. Segurança do Windows preservada." TextWrapping="Wrap" Foreground="#9BDFCB" FontSize="12"/></Border><TextBlock Text="Gaming · Benchmark · Network
Extensões em preparação" TextWrapping="Wrap" FontSize="12" Foreground="#99A9C1"/></StackPanel></Border>
 <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled"><StackPanel Padding="32" Spacing="22" MaxWidth="1200" HorizontalAlignment="Stretch">
 <StackPanel Spacing="5"><TextBlock Text="O teu PC, em perspetiva." FontSize="30" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" Foreground="#99A9C1"/></StackPanel>
 <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
 <Border Background="#172033" CornerRadius="14" Padding="22"><StackPanel Spacing="12"><TextBlock Text="PROCESSADOR" Foreground="#99A9C1"/><TextBlock Text="{Binding CpuText}" FontSize="42" FontWeight="SemiBold"/><ProgressBar Value="{Binding CpuPercent}" Maximum="100" Foreground="#74D9CF"/><TextBlock Text="{Binding CpuName}" TextWrapping="Wrap"/></StackPanel></Border>
 <Border Grid.Column="1" Background="#172033" CornerRadius="14" Padding="22"><StackPanel Spacing="12"><TextBlock Text="MEMÓRIA" Foreground="#99A9C1"/><TextBlock Text="{Binding MemoryText}" FontSize="32" FontWeight="SemiBold"/><ProgressBar Value="{Binding MemoryPercent}" Maximum="100" Foreground="#9C92FF"/><TextBlock Text="{Binding RamText}"/></StackPanel></Border></Grid>
 <Border Background="#172033" CornerRadius="14" Padding="22"><StackPanel Spacing="12"><TextBlock Text="Hardware detetado" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="GRÁFICOS" Foreground="#99A9C1"/><TextBlock Text="{Binding GpuName}" TextWrapping="Wrap"/><TextBlock Text="DISCOS / VOLUMES" Foreground="#99A9C1"/><TextBlock Text="{Binding Disks}" TextWrapping="Wrap"/></StackPanel></Border>
 <Border Background="#172033" CornerRadius="14" Padding="22"><StackPanel Spacing="12"><TextBlock Text="O teu perfil" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Normal: 2s · Gaming: 5s · Trabalho: 3s entre amostras. Altera apenas a monitorização da app." TextWrapping="Wrap" Foreground="#99A9C1"/><StackPanel Orientation="Horizontal" Spacing="12"><ComboBox ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" Width="150" AutomationProperties.Name="Perfil"/><Button Content="Aplicar perfil" Command="{Binding ApplyProfileCommand}" Style="{StaticResource AccentButtonStyle}"/><Button Content="Desfazer última alteração" Command="{Binding UndoCommand}"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="Ativo:"/><TextBlock Text="{Binding ActiveProfile}" Foreground="#74D9CF" FontWeight="SemiBold"/></StackPanel></StackPanel></Border>
 <Border Background="#172033" CornerRadius="14" Padding="22"><StackPanel Spacing="12"><TextBlock Text="Histórico" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding History}" TextWrapping="Wrap" Foreground="#B9C7DA"/></StackPanel></Border>
 </StackPanel></ScrollViewer></Grid>
</Window>
