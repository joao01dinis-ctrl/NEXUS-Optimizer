                <Border Background="#171D2F" CornerRadius="14" Padding="22" BorderBrush="#2A3350" BorderThickness="1">
                  <StackPanel Spacing="14">
                    <TextBlock Text="Dar prioridade ao teu jogo" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Abre o jogo e atualiza a lista. Escolhe a aplicação certa: o NEXUS dá prioridade de CPU acima do normal até ela fechar. Pode reduzir a fluidez de outras apps; não altera afinidade nem usa prioridade em tempo real." TextWrapping="Wrap" Foreground="#C3CBE0" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <Button Content="Atualizar lista" Click="RefreshGames" />
                      <Button x:Name="PriorityButton" Content="Priorizar aplicação" Click="ApplyPriority" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                    <TextBlock Text="Mostra apps com janela e prioridade normal nesta sessão. Jogos protegidos podem recusar a alteração." TextWrapping="Wrap" Foreground="#95A1BF" />
                  </StackPanel>
                </Border>
                <Border Background="#171D2F" CornerRadius="14" Padding="22" BorderBrush="#2A3350" BorderThickness="1">
                  <StackPanel Spacing="14">
                    <TextBlock Text="Definições de jogo do Windows" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Confere o Modo de Jogo e escolhe a GPU por aplicação nas definições oficiais." TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <Button Content="Modo de Jogo" Tag="ms-settings:gaming-gamemode" Click="OpenSetting" />
                      <Button Content="Preferência de GPU" Tag="ms-settings:display-advancedgraphics" Click="OpenSetting" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Expander>
          </StackPanel>
          <StackPanel x:Name="MemoryPanel" Visibility="Collapsed" Spacing="18">
            <Border Background="#171D2F" CornerRadius="14" Padding="22" BorderBrush="#2A3350" BorderThickness="1">
              <StackPanel Spacing="12">
                <TextBlock Text="Onde está a tua memória?" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Processos acessíveis da tua sessão, ordenados pela RAM residente. RAM em cache é reutilizada pelo Windows quando necessário. Fechar uma app que não precisas costuma ser mais útil do que esvaziar caches repetidamente." TextWrapping="Wrap" Foreground="#C3CBE0" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Button Content="Atualizar utilização" Click="RefreshMemory" />
                  <Button Content="Abrir Gestor de Tarefas" Tag="taskmgr.exe" Click="OpenTool" />
                </StackPanel>
                <ComboBox x:Name="MemoryAppChoice" DisplayMemberPath="Display" HorizontalAlignment="Stretch" AutomationProperties.Name="Aplicação para rever memória" />
                <Button Content="Rever redução de RAM residente" Click="TrimMemory" />
                <TextBlock Text="Só para uma aplicação em segundo plano. Pode causar mais leituras do disco. A memória privada não é libertada e as páginas podem voltar à RAM. Não limpa standby ou páginas modificadas do sistema." TextWrapping="Wrap" />
                <TextBlock x:Name="MemoryProcessesText" TextWrapping="Wrap" FontFamily="Consolas" />
                <TextBlock Text="RAM residente pode incluir páginas partilhadas entre processos. A memória privada é outra medida; a soma das linhas não é a RAM total do PC. O NEXUS não termina processos." TextWrapping="Wrap" Foreground="#95A1BF" />
              </StackPanel>
            </Border>
            <Expander Header="Limpeza de ficheiros e caches" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
