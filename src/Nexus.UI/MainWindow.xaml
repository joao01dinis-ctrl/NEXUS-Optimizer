                <Border Background="#121819" CornerRadius="14" Padding="22" BorderBrush="#283234" BorderThickness="1">
                  <StackPanel Spacing="14">
                    <TextBlock Text="Definições de jogo do Windows" FontSize="20" FontWeight="SemiBold" />
