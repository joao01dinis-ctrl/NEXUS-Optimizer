                <TextBlock x:Name="SessionStatusText" Text="Sem sessão ativa." TextWrapping="Wrap" />
                <TextBlock Text="Mantém o NEXUS aberto. Fechar normalmente tenta repor a sessão. Após uma falha ou reinício, usa Terminar e repor ao voltar a abrir. Energia por sessão exige alimentação à corrente; se mudar, a sessão é terminada e reposta. Alterações externas podem impedir a reposição." TextWrapping="Wrap" Foreground="#95A1BF" />
              </StackPanel>
            </Border>
            <Border Background="#171D2F" BorderBrush="#2A3350" BorderThickness="1" CornerRadius="14" Padding="20">
