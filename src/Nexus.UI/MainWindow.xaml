                      <ListView.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Display}" TextWrapping="Wrap" FontSize="12" Margin="0,5" />
                        </DataTemplate>
                      </ListView.ItemTemplate>
                    </ListView>
                    <Button x:Name="RecycleTemporaryButton" Content="Enviar selecionados à Lixeira" Click="RecycleTemporary" IsEnabled="False" />
                    <TextBlock Text="Podes recuperar os ficheiros na Lixeira do Windows. O espaço continua ocupado até a esvaziares por tua decisão. Esta ação não entra no undo das definições do sistema." TextWrapping="Wrap" Foreground="#95A1BF" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Expander>
          </StackPanel>
          <StackPanel x:Name="NetworkPanel" Visibility="Collapsed" Spacing="18">
            <Border Background="#171D2F" CornerRadius="14" Padding="22" BorderBrush="#2A3350" BorderThickness="1">
              <StackPanel Spacing="14">
                <TextBlock Text="Configurar DNS com histórico" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Requer iniciar como administrador. Escolhe uma interface Ethernet/Wi-Fi elegível e um servidor IPv4. Não configura DNS cifrado, VPNs ou políticas de rede. A comparação DNS abaixo não escolhe nem aplica automaticamente." TextWrapping="Wrap" />
                <ComboBox x:Name="DnsAdapterChoice" HorizontalAlignment="Stretch" AutomationProperties.Name="Adaptador DNS" />
                <ComboBox x:Name="DnsProviderChoice" HorizontalAlignment="Stretch" AutomationProperties.Name="Fornecedor DNS" />
                <CheckBox x:Name="FlushAfterDns" Content="Limpar cache DNS após aplicar" />
                <StackPanel Spacing="10">
                  <Button Content="Rever e aplicar DNS escolhido" Click="ApplyDns" />
                  <Button Content="Rever DNS automático da rede" Click="AutomaticDns" />
                  <Button Content="Limpar cache DNS" Click="FlushDns" />
                  <Button Content="Rever renovação de IP por DHCP" Click="RenewIp" />
                </StackPanel>
                <TextBlock Text="Para repor exatamente o DNS anterior, usa Desfazer no Histórico. Usar DNS automático é uma nova escolha. Limpar cache e renovar IP não têm undo." TextWrapping="Wrap" Foreground="#95A1BF" />
              </StackPanel>
            </Border>
            <Border Background="#171D2F" CornerRadius="14" Padding="22" BorderBrush="#2A3350" BorderThickness="1">
              <StackPanel Spacing="14">
